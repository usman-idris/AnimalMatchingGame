<ContentPage x:Class="AnimalMatchingGame.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button x:Name="PlayAgainButton" Text="Play again?" FontSize="Large" Clicked="PlayAgainButton_Clicked" />
            <Label x:Name="TimeElapsedLabel" Text="Time Elapsed: 0.0 seconds" FontSize="Large" />

            <FlexLayout x:Name="AnimalButtons" Wrap="Wrap" MaximumWidthRequest="400" IsVisible="False">
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
                <Button HeightRequest="100" WidthRequest="100" FontSize="60" BackgroundColor="LightBlue" BorderColor="Black" BorderWidth="1" Clicked="Button_Clicked" />
            </FlexLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
